{
  "name": "@ibbr-engineering/observability",
  "version": "1.1.0",
  "description": "Node.js observability metrics client conforming to metrics-contract v1.5.0",
  "license": "Apache-2.0",
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./loopback3": {
      "types": "./dist/adapters/loopback3.d.ts",
      "default": "./dist/adapters/loopback3.js"
    },
    "./express": {
      "types": "./dist/adapters/express.d.ts",
      "default": "./dist/adapters/express.js"
    },
    "./loopback4": {
      "types": "./dist/adapters/loopback4.d.ts",
      "default": "./dist/adapters/loopback4.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "contract:sync": "node scripts/sync-contract.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test dist-test/test/*.test.js",
    "prepack": "npm run build",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@loopback/context": "^6.1.5",
    "@loopback/core": "^5.1.5",
    "@loopback/rest": "^13.1.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "@loopback/context": ">=6",
    "@loopback/core": ">=5",
    "@loopback/rest": ">=13"
  },
  "peerDependenciesMeta": {
    "@loopback/context": {
      "optional": true
    },
    "@loopback/core": {
      "optional": true
    },
    "@loopback/rest": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=16"
  }
}
